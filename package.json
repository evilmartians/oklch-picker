{
  "name": "oklch-picker",
  "private": true,
  "homepage": "https://oklch.com/",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build -m production",
    "clean": "rm -Rf ./dist/",
    "build:lch": "LCH=1 vite build -m production && ./lch.sh",
    "test:js": "oxlint",
    "test:css": "stylelint .",
    "test:build": "node --run build && size-limit && node --run build:lch",
    "test:unit": "bnt",
    "test": "FORCE_COLOR=1 pnpm run /^test:/"
  },
  "dependencies": {
    "@colordx/core": "^7.3.0",
    "@colordx/gpu": "^1.0.0",
    "@csstools/postcss-oklab-function": "^5.0.15",
    "@nanostores/persistent": "^1.3.5",
    "autoprefixer": "^10.6.1",
    "delaunator": "^5.1.0",
    "jstransformer-markdown-it": "^3.0.0",
    "lightningcss": "^1.33.0",
    "nanodelay": "^2.0.2",
    "nanostores": "^1.5.4",
    "plausible-client": "^2.0.0",
    "postcss": "^8.5.28",
    "postcss-media-minmax": "^5.0.0",
    "postcss-mixins": "^12.1.2",
    "postcss-nesting": "^14.0.2",
    "postcss-opacity-percentage": "^3.0.0",
    "three": "~0.186.1",
    "vite": "^8.3.2",
    "vite-plugin-pug-transformer": "^1.0.8"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.2.0",
    "@logux/stylelint-config": "^1.1.0",
    "@size-limit/file": "^14.1.0",
    "@types/delaunator": "^5.0.3",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "better-node-test": "^1.0.0",
    "happy-dom": "^20.14.5",
    "nano-staged": "^1.0.2",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.1.0",
    "stylelint": "^17.16.0",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
